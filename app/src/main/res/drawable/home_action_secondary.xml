<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#555555" /><corners android:radius="24dp" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#444444" /><corners android:radius="24dp" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item>
        <shape><solid android:color="#292929" /><corners android:radius="24dp" /><stroke android:width="1dp" android:color="#424242" /></shape>
    </item>
</selector>
