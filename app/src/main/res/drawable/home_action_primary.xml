<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#A91C27" /><corners android:radius="24dp" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#E1323E" /><corners android:radius="24dp" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item>
        <shape><solid android:color="#BE2531" /><corners android:radius="24dp" /></shape>
    </item>
</selector>
